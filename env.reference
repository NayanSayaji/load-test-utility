# Load Testing Application Environment Reference
# This file documents all available environment variables
# Copy this file to .env and modify the values as needed

# =============================================================================
# RESPONSE STORAGE CONFIGURATION
# =============================================================================

# Whether to store response bodies (true/false)
# Required: No | Default: false
# Example: STORE_RESPONSE_BODY=true
STORE_RESPONSE_BODY=true

# Whether to store response headers (true/false)
# Required: No | Default: false
# Example: STORE_RESPONSE_HEADERS=true
STORE_RESPONSE_HEADERS=true

# Maximum response body size to store (in bytes)
# Required: No | Default: 10000
# Example: MAX_RESPONSE_BODY_SIZE=5000
MAX_RESPONSE_BODY_SIZE=5000

# Whether to truncate large responses (true/false)
# Required: No | Default: true
# Example: TRUNCATE_LARGE_RESPONSES=true
TRUNCATE_LARGE_RESPONSES=true

# =============================================================================
# GLOBAL TEST CONFIGURATION
# =============================================================================

# Test type: single-config, multi-config, preset, environment, weighted
# Required: No | Default: multi-config
TEST_TYPE=multi-config

# Total number of requests across all configurations
# Required: No | Default: 15
TOTAL_REQUESTS=30

# Distribution strategy: round_robin, equal, proportional
# Required: No | Default: round_robin
DISTRIBUTION_STRATEGY=round_robin

# Show progress updates during execution (true/false)
# Required: No | Default: false
PROGRESS=true

# Preset name for preset tests (api-test, pharma-api)
# Required: Yes (for preset tests) | Default: -
USE_PRESET=

# Comma-separated config IDs for environment tests
# Required: Yes (for environment tests) | Default: API1,API2
CONFIG_IDS=API1,API2,API3

# =============================================================================
# PER-CONFIGURATION ENVIRONMENT VARIABLES
# =============================================================================
# Each configuration can be defined using prefixed environment variables
# Replace {PREFIX} with your config ID (e.g., API1, API2, etc.)

# {PREFIX}URL - Target URL for the API endpoint
# Required: Yes | Default: -
# Example: API1_URL=https://api.example.com

# {PREFIX}TOTAL_REQUESTS - Number of requests for this config
# Required: No | Default: 10
# Example: API1_TOTAL_REQUESTS=20

# {PREFIX}CONCURRENCY - Max concurrent requests for this config
# Required: No | Default: 5
# Example: API1_CONCURRENCY=10

# {PREFIX}METHOD - HTTP method
# Required: No | Default: GET
# Valid values: GET, POST, PUT, DELETE, PATCH
# Example: API1_METHOD=POST

# {PREFIX}WEIGHT - Weight for proportional distribution
# Required: No | Default: 1
# Example: API1_WEIGHT=2

# {PREFIX}TIMEOUT - Request timeout in milliseconds
# Required: No | Default: 30000
# Example: API1_TIMEOUT=60000

# {PREFIX}HEADER_{HEADER_NAME} - HTTP headers
# Required: No | Default: -
# Replace {HEADER_NAME} with actual header name
# Example: API1_HEADER_AUTHORIZATION=Bearer token123
# Example: API1_HEADER_CONTENT_TYPE=application/json

# =============================================================================
# EXAMPLE CONFIGURATIONS
# =============================================================================

# API1 CONFIGURATION
API1_URL=https://jsonplaceholder.typicode.com/posts
API1_TOTAL_REQUESTS=10
API1_CONCURRENCY=5
API1_METHOD=GET
API1_WEIGHT=2
API1_TIMEOUT=30000
API1_HEADER_CONTENT_TYPE=application/json
API1_HEADER_ACCEPT=application/json
API1_HEADER_USER_AGENT=LoadTestTool/1.0

# API2 CONFIGURATION
API2_URL=https://jsonplaceholder.typicode.com/users
API2_TOTAL_REQUESTS=10
API2_CONCURRENCY=5
API2_METHOD=GET
API2_WEIGHT=1
API2_TIMEOUT=30000
API2_HEADER_CONTENT_TYPE=application/json
API2_HEADER_ACCEPT=application/json
API2_HEADER_USER_AGENT=LoadTestTool/1.0

# API3 CONFIGURATION
API3_URL=https://jsonplaceholder.typicode.com/comments
API3_TOTAL_REQUESTS=10
API3_CONCURRENCY=5
API3_METHOD=GET
API3_WEIGHT=1
API3_TIMEOUT=30000
API3_HEADER_CONTENT_TYPE=application/json
API3_HEADER_ACCEPT=application/json
API3_HEADER_USER_AGENT=LoadTestTool/1.0

# =============================================================================
# AUTHENTICATION EXAMPLES
# =============================================================================

# Bearer Token Authentication
# API1_HEADER_AUTHORIZATION=Bearer your-token-here
# API2_HEADER_AUTHORIZATION=Bearer your-token-here

# Basic Authentication (base64 encoded username:password)
# API1_HEADER_AUTHORIZATION=Basic dXNlcm5hbWU6cGFzc3dvcmQ=
# API2_HEADER_AUTHORIZATION=Basic dXNlcm5hbWU6cGFzc3dvcmQ=

# API Key Authentication
# API1_HEADER_X_API_KEY=your-api-key-here
# API2_HEADER_X_API_KEY=your-api-key-here

# Custom Headers
# API1_HEADER_X_CUSTOM_HEADER=custom-value
# API2_HEADER_X_CUSTOM_HEADER=custom-value

# =============================================================================
# TEST TYPE EXAMPLES
# =============================================================================

# MULTI-CONFIG TEST
# TEST_TYPE=multi-config
# TOTAL_REQUESTS=30
# DISTRIBUTION_STRATEGY=round_robin
# PROGRESS=true
# CONFIG_IDS=API1,API2,API3

# SINGLE CONFIG TEST
# TEST_TYPE=single-config
# TOTAL_REQUESTS=25
# PROGRESS=true

# PRESET TEST
# TEST_TYPE=preset
# USE_PRESET=pharma-api
# TOTAL_REQUESTS=50
# PROGRESS=true

# ENVIRONMENT TEST
# TEST_TYPE=environment
# CONFIG_IDS=API1,API2
# TOTAL_REQUESTS=35
# DISTRIBUTION_STRATEGY=proportional

# WEIGHTED TEST
# TEST_TYPE=weighted
# TOTAL_REQUESTS=40
# PROGRESS=true
# API1_WEIGHT=3
# API2_WEIGHT=2
# API3_WEIGHT=1

# =============================================================================
# DISTRIBUTION STRATEGY EXAMPLES
# =============================================================================

# ROUND-ROBIN DISTRIBUTION
# DISTRIBUTION_STRATEGY=round_robin
# # Distributes requests: 1,2,3,1,2,3...
# # Example: 10 requests, 3 configs → Config1: 4, Config2: 3, Config3: 3

# EQUAL DISTRIBUTION
# DISTRIBUTION_STRATEGY=equal
# # Distributes requests equally among all configs
# # Example: 10 requests, 3 configs → Config1: 3, Config2: 3, Config3: 4

# PROPORTIONAL DISTRIBUTION
# DISTRIBUTION_STRATEGY=proportional
# # Distributes requests based on weights
# # Example: 10 requests, Config1(weight:1), Config2(weight:2), Config3(weight:1)
# # → Config1: 3, Config2: 5, Config3: 2

# =============================================================================
# PERFORMANCE TESTING CONFIGURATIONS
# =============================================================================

# LIGHT LOAD TEST
# TOTAL_REQUESTS=50
# API1_TOTAL_REQUESTS=20
# API1_CONCURRENCY=10
# API2_TOTAL_REQUESTS=15
# API2_CONCURRENCY=8
# API3_TOTAL_REQUESTS=15
# API3_CONCURRENCY=8

# MEDIUM LOAD TEST
# TOTAL_REQUESTS=200
# API1_TOTAL_REQUESTS=80
# API1_CONCURRENCY=20
# API2_TOTAL_REQUESTS=60
# API2_CONCURRENCY=15
# API3_TOTAL_REQUESTS=60
# API3_CONCURRENCY=15

# HEAVY LOAD TEST
# TOTAL_REQUESTS=1000
# API1_TOTAL_REQUESTS=400
# API1_CONCURRENCY=50
# API2_TOTAL_REQUESTS=300
# API2_CONCURRENCY=40
# API3_TOTAL_REQUESTS=300
# API3_CONCURRENCY=40

# STRESS TEST
# TOTAL_REQUESTS=5000
# API1_TOTAL_REQUESTS=2000
# API1_CONCURRENCY=100
# API2_TOTAL_REQUESTS=1500
# API2_CONCURRENCY=75
# API3_TOTAL_REQUESTS=1500
# API3_CONCURRENCY=75

# =============================================================================
# LEGACY CONFIGURATION (for backward compatibility)
# =============================================================================

# Single URL for legacy single-config tests
# URL=https://api.example.com

# Legacy concurrency setting
# CONCURRENCY=10

# =============================================================================
# VALIDATION RULES
# =============================================================================

# 1. URLs must be valid HTTP/HTTPS URLs
# 2. Numeric values must be positive integers
# 3. Concurrency cannot exceed total requests per configuration
# 4. Distribution strategy must be one of: round_robin, equal, proportional
# 5. HTTP methods must be one of: GET, POST, PUT, DELETE, PATCH
# 6. TEST_TYPE must be one of: single-config, multi-config, preset, environment, weighted
# 7. For preset tests, USE_PRESET must be specified
# 8. For environment tests, CONFIG_IDS must be specified
# 9. Header names in environment variables are converted to lowercase with hyphens
#    Example: API1_HEADER_CONTENT_TYPE becomes "content-type"

# =============================================================================
# COMMON HEADERS
# =============================================================================

# Content-Type headers
# API1_HEADER_CONTENT_TYPE=application/json
# API1_HEADER_CONTENT_TYPE=application/xml
# API1_HEADER_CONTENT_TYPE=text/plain

# Authentication headers
# API1_HEADER_AUTHORIZATION=Bearer your-token
# API1_HEADER_AUTHORIZATION=Basic base64-encoded-credentials
# API1_HEADER_X_API_KEY=your-api-key

# Accept headers
# API1_HEADER_ACCEPT=application/json
# API1_HEADER_ACCEPT=application/xml
# API1_HEADER_ACCEPT=*/*

# Custom headers
# API1_HEADER_X_CUSTOM_HEADER=custom-value
# API1_HEADER_X_REQUEST_ID=unique-request-id
# API1_HEADER_X_CLIENT_VERSION=1.0.0

# User-Agent headers
# API1_HEADER_USER_AGENT=LoadTestTool/1.0
# API1_HEADER_USER_AGENT=MyApp/1.0.0

# Cache control headers
# API1_HEADER_CACHE_CONTROL=no-cache
# API1_HEADER_CACHE_CONTROL=max-age=3600
